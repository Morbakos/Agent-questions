services:
  agent-questions:
    build: .
    restart: unless-stopped
    environment:
      AQ_ALLOWED_HOSTS: agent-questions
      AQ_PUBLIC_URL: http://127.0.0.1:4317
    ports:
      - "127.0.0.1:4317:4317"
    volumes:
      - aq-data:/data
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:4317/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  mcpo:
    image: ghcr.io/open-webui/mcpo:main
    restart: unless-stopped
    command: ["--host", "0.0.0.0", "--port", "8000", "--api-key", "change-me", "--config", "/config/mcpo.json"]
    volumes:
      - ./mcpo.json:/config/mcpo.json:ro
    depends_on:
      agent-questions:
        condition: service_healthy
    ports:
      - "127.0.0.1:8000:8000"

  ollama:
    image: ollama/ollama:latest
    restart: unless-stopped
    volumes:
      - ollama:/root/.ollama
    healthcheck:
      test: ["CMD", "ollama", "list"]
      interval: 5s
      timeout: 5s
      retries: 20

  ollama-pull:
    image: ollama/ollama:latest
    depends_on:
      ollama:
        condition: service_healthy
    environment:
      OLLAMA_HOST: http://ollama:11434
    entrypoint: ["ollama", "pull", "gemma4:e2b"]
    restart: "no"

  open-webui:
    image: ghcr.io/open-webui/open-webui:main
    container_name: open-webui-ollama
    restart: unless-stopped
    depends_on:
      ollama:
        condition: service_healthy
      mcpo:
        condition: service_started
    ports:
      - "127.0.0.1:8080:8080"
    environment:
      WEBUI_SECRET_KEY: "36e002952ecf207d447bd595165cbb50dd0e61f0fdd4dd9f799f265d3a4c69cb"
      OLLAMA_BASE_URL: http://ollama:11434
      HF_HUB_OFFLINE: "1"
      GLOBAL_LOG_LEVEL: DEBUG
    volumes:
      - open-webui:/app/backend/data

volumes:
  aq-data:
  ollama:
  open-webui: