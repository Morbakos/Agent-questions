# Server profile: network access, several users with accounts and passwords.
# The server refuses to start if a required variable is missing. Do not commit your filled-in copy.

AQ_DEPLOYMENT_MODE=server

# --- Required ---
# Public URL seen by users (HTTPS, terminated by the reverse proxy).
AQ_PUBLIC_URL=https://questions.example.com
# Persistent volume dedicated to the SQLite database (a single writer process).
AQ_DATA_DIR=/data

# --- First administrator (created only if the database has no account) ---
# Without AQ_ADMIN_PASSWORD, a random password is printed once in the logs of the first start.
# AQ_ADMIN_USERNAME=admin
# AQ_ADMIN_PASSWORD=

# --- Optional ---
# Network listener (the reverse proxy connects here).
# AQ_BIND_HOST=0.0.0.0
# AQ_PORT=4317
# Additional Host names and additional origins (exact values, never a wildcard).
# AQ_ALLOWED_HOSTS=agent-questions
# AQ_ALLOWED_ORIGINS=https://autre.example.com
