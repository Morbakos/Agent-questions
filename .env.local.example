# Local profile: one user on their own machine, no identity provider (default values).
# No variable is required; uncomment to change one.

AQ_DEPLOYMENT_MODE=local
# Listener: 127.0.0.1, ::1 or localhost only. Any other address is refused at startup.
# AQ_BIND_HOST=127.0.0.1
# AQ_PORT=4317
# AQ_DATA_DIR=~/.agent-questions
# AQ_NO_OPEN=1
# Additional origins allowed to call /mcp from a browser (exact values, never a wildcard).
# AQ_ALLOWED_ORIGINS=http://localhost:8080
