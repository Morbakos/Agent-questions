{
	"name": "agent-questions",
	"version": "0.1.0",
	"private": true,
	"description": "Interface web pour poser des questions complexes à l'utilisateur depuis un agent (serveur MCP Streamable HTTP + UI Angular + SQLite).",
	"workspaces": [
		"server",
		"ui"
	],
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"build": "npm run build -w ui && npm run build -w server",
		"start": "npm run start -w server",
		"dev:server": "AQ_DEV=1 npm run dev -w server",
		"dev:ui": "npm run start -w ui",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"angular-eslint": "^21.4.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"typescript-eslint": "^8.72.1"
	}
}
