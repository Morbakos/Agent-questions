{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"declaration": false,
		"emitDecoratorMetadata": true,
		"incremental": true,
		"noEmit": false,
		"outDir": "./dist",
		"rootDir": ".",
		"sourceMap": true,
		"strictPropertyInitialization": false,
		"paths": {
			"@app/*": ["./src/app/*"],
			"@server/*": ["./src/*"]
		}
	},
	"include": ["src", "test", "vitest.alias.ts", "vitest.config.ts", "vitest.config.e2e.ts"]
}
