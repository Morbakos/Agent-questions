{
	"name": "@agent-questions/server",
	"version": "0.1.0",
	"description": "Serveur MCP + interface web pour poser à l'utilisateur des questions longues ou complexes depuis un agent.",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"agent",
		"ask-user",
		"claude-code"
	],
	"license": "MIT",
	"author": "Alexis Jacob",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Morbakos/Agent-questions.git",
		"directory": "packages/server"
	},
	"homepage": "https://github.com/Morbakos/Agent-questions#readme",
	"bugs": "https://github.com/Morbakos/Agent-questions/issues",
	"type": "module",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"typecheck": "tsc --noEmit",
		"build": "npm run typecheck && node ../../scripts/build-server.mjs",
		"start": "node dist/index.js"
	},
	"dependencies": {
		"@fastify/static": "^8.0.0",
		"@modelcontextprotocol/sdk": "^1.12.0",
		"fastify": "^5.0.0",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@agent-questions/shared": "*",
		"@agent-questions/ui": "*",
		"@types/node": "^24.0.0",
		"tsx": "^4.19.0",
		"typescript": "^5.8.0"
	},
	"private": true
}
